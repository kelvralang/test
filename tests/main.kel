const test = @import("github.com/kelvralang/test")
test.assert(true, "true must pass")
test.equal(42, 42, "equal values must pass")
test.equal("kelvra", "kelvra", "equal strings must pass")
test.notEqual(42, 7, "different values must pass")
test.isTrue(3 < 4, "true comparison must pass")
test.isFalse(4 < 3, "false comparison must pass")
test.isNull(null, "null value must pass")
test.notNull("value", "non-null value must pass")
test.approxEqual(0.1 + 0.2, 0.3, 0.000001, "nearby floats must pass")
